@model List<ST10444488_POE.Models.Cart>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Your Cart";
}

<h2 class="mb-4 text-center">🛒 Your Cart</h2>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">Your cart is currently empty.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Selected Size</th>
                    <th>Line Total</th>
                    <th>Category</th>
                    <th>Available Sizes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="img-thumbnail" style="height: 80px;" />
                            }
                            else
                            {
                                <span class="text-muted">No image</span>
                            }
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>R @item.Price.ToString("0.00")</td>
                        <td>@item.Quantity</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.SelectedSize))
                            {
                                <span class="badge bg-success">@item.SelectedSize</span>
                            }
                            else
                            {
                                <span class="text-muted">Not selected</span>
                            }
                        </td>
                        <td class="fw-bold text-primary">@($"R {item.Price * item.Quantity:0.00}")</td>
                        <td>@item.Category</td>
                        <td>
                            @foreach (var size in item.Sizes?.Split(',') ?? new string[0])
                            {
                                <span class="badge bg-warning text-dark me-1">@size.Trim()</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Total: <strong class="text-success">R @ViewBag.Total.ToString("0.00")</strong></h4>

        <div>
            <form asp-action="PlaceOrder" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary me-2">Place Order</button>
            </form>

            <form asp-action="Clear" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger">Clear Cart</button>
            </form>
        </div>
    </div>

    @if (TempData["OrderSuccess"] != null)
    {
        <div class="alert alert-success mt-3 text-center">@TempData["OrderSuccess"]</div>
    }
}