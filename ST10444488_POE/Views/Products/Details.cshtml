@model ST10444488_POE.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Details";
}

<h1 class="mb-4">Product Details</h1>

<div class="card shadow-sm p-4 bg-light">
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px;" />
            }
            else
            {
                <div class="text-muted">No image available</div>
            }
        </div>

        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">R @Model.Price</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                @if (!string.IsNullOrEmpty(Model.Sizes))
                {
                    <dt class="col-sm-4">Available Sizes</dt>
                    <dd class="col-sm-8">
                        @foreach (var size in Model.Sizes.Split(','))
                        {
                            <span class="badge bg-warning text-dark me-1">@size.Trim()</span>
                        }
                    </dd>
                }
            </dl>

            <div class="mt-4">
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="rowKey" value="@Model.RowKey" />
                    <input type="hidden" name="name" value="@Model.Name" />
                    <input type="hidden" name="price" value="@Model.Price" />
                    <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="sizes" value="@Model.Sizes" />

                    <div class="mb-3">
                        <label for="selectedSize" class="form-label">Select Size:</label>
                        <select name="selectedSize" class="form-select" required>
                            @foreach (var size in Model.Sizes.Split(','))
                            {
                                <option value="@size.Trim()">@size.Trim()</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success me-2">Add to Cart</button>
                </form>

                <a asp-action="Edit" asp-route-id="@Model?.RowKey" class="btn btn-primary me-2">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>